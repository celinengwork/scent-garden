---
/**
 * Full-bleed section background (absolute, inset 0, object-fit: cover).
 * Pass either a bundled background (`image`) or a slot id (`slot`) the owner can fill later.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Slot from './Slot.astro';

interface Props {
  image?: ImageMetadata;
  slot?: string;
  eager?: boolean;
}

const { image, slot, eager = false } = Astro.props;
---

<div class="sg-bg" aria-hidden="true">
  {
    image ? (
      <Image
        src={image}
        alt=""
        widths={[768, 1280, 1920].filter((w) => w <= image.width)}
        sizes="100vw"
        format="webp"
        quality={78}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        class="slot-img"
      />
    ) : (
      slot && <Slot id={slot} sizes="100vw" widths={[768, 1280, 1920]} />
    )
  }
</div>
